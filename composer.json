{
  "name": "getlaraplate/laracore",
  "vendor": "getlaraplate",
  "description": "Laraplate Core module: users, ACL, settings, CRUD API, search, versioning and the shared services every other module builds on.",
  "version": "v1.79.0",
  "keywords": [
    "laravel",
    "laraplate",
    "core"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "laravel-module",
  "authors": [
    {
      "name": "Swolley",
      "email": "myentity@inwind.it"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-redis": "*",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "ext-intl": "*",
    "ext-sockets": "*",
    "doctrine/dbal": "^4.4.3",
    "laravel/framework": "^13.0",
    "laravel/fortify": "^1.36.2",
    "hedii/laravel-gelf-logger": "^13.0",
    "lab404/laravel-impersonate": "^1.7.8",
    "mtrajano/laravel-swagger": "^0.6.4",
    "spatie/laravel-permission": "^8.3",
    "staudenmeir/laravel-adjacency-list": "^1.26.2",
    "laravel/socialite": "^5.27",
    "wotz/laravel-swagger-ui": "^2.1",
    "elasticsearch/elasticsearch": "^9.5",
    "laravel/horizon": "^5.46",
    "babenkoivan/elastic-scout-driver": "^6.0",
    "typesense/typesense-php": "^6.0",
    "laravel/scout": "^11.9",
    "matanyadaev/laravel-eloquent-spatial": "^4.7",
    "babenkoivan/elastic-scout-driver-plus": "^7.0",
    "spatie/eloquent-sortable": "^5.0",
    "spatie/laravel-medialibrary": "^11.22.1",
    "livewire/livewire": "^4.3",
    "filament/spatie-laravel-media-library-plugin": "^5.6.3",
    "spatie/fork": "^1.2.7",
    "yajra/laravel-oci8": "^13.14",
    "james-heinrich/getid3": "^1.9",
    "smalot/pdfparser": "^2.12"
  },
  "scripts": {
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [],
      "aliases": {},
      "dont-discover": [
        "yajra/laravel-oci8"
      ]
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\Core\\": "app/",
      "Modules\\Core\\Database\\Factories\\": "database/factories/",
      "Modules\\Core\\Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Helpers/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\Core\\Tests\\": "tests/"
    },
    "classmap": [
      "stubs/App/"
    ]
  },
  "config": {
    "platform": {
      "ext-oci8": "3.0.1"
    },
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "wikimedia/composer-merge-plugin": true
    }
  }
}
